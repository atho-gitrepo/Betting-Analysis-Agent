{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "streamlit run dashboard.py --server.port=8080 --server.address=0.0.0.0 & python analytics_service.py && wait",
    "healthcheckPath": "/_stcore/health",
    "numReplicas": 1
  },
  "crons": [
    {
      "schedule": "0 9 * * *",
      "command": "python analytics_service.py"
    },
    {
      "schedule": "0 18 * * *",
      "command": "python analytics_service.py"
    }
  ]
}